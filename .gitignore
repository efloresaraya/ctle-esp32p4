# ── ESP-IDF build artifacts ──────────────────────────────────────────────────
firmware/build/
firmware/sdkconfig
firmware/.enki/
firmware/components/*/build/
firmware/spiffs.bin
firmware/spiffs_ctle5.bin
firmware/spiffs_pctle32.bin

# ── Large model files (download separately — see README) ──────────────────────
models/tinyllamas/
models/tinyllamas_full/
models/stories15M/model.safetensors
spiffs_data/

# ── Compressed weights ARE tracked (7–9 MB each, no LFS needed) ──────────────
# weights/*.bin  ← intentionally NOT ignored

# ── Python cache & Numba JIT ──────────────────────────────────────────────────
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.nbi
*.nbc
*.egg-info/
.venv/
venv/
env/

# ── macOS / IDE ───────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.idea/
.vscode/
*.swp
*~

# ── LaTeX intermediates (keep .tex; include compiled ESL PDF) ─────────────────
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/ctle_p4.pdf
paper/texput.log
# ctle_esl.pdf IS tracked (useful for readers without LaTeX)

# ── Misc ──────────────────────────────────────────────────────────────────────
tmp/
*.tmp
*.bak
