# ── Build artifacts ─────────────────────────────────────────────────────────────
firmware/build/
firmware/sdkconfig         # generated by IDF cmake; sdkconfig.defaults is tracked
firmware/.enki/
firmware/components/*/build/
build/

# ── Model files (too large for git — download separately) ───────────────────────
models/tinyllamas/
models/stories15M/model.safetensors
models/stories15M/tokenizer.model
spiffs_data/

# Keep empty-directory markers
!models/.gitkeep
!weights/.gitkeep

# ── Binary weights (re-generated by compress.py) ────────────────────────────────
weights/*.bin
weights/*.safetensors

# ── Python cache ────────────────────────────────────────────────────────────────
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
env/

# ── macOS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.idea/
.vscode/
*.swp
*~

# ── LaTeX intermediates (keep .tex and .bib; exclude compiled output) ────────────
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.pdf

# ── Temp / scratch ───────────────────────────────────────────────────────────────
tmp/
*.tmp
*.bak
